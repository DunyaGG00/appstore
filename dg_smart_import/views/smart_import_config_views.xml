<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ────────────────────────────────────────────────────────── -->
    <record id="view_dg_smart_import_config_list" model="ir.ui.view">
        <field name="name">dg.smart.import.config.list</field>
        <field name="model">dg.smart.import.config</field>
        <field name="arch" type="xml">
            <list string="Smart Import Configuration">
                <field name="model_id"/>
                <field name="model_name" string="Technical Name" optional="show"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="server_action_id"
                       string="Bound Action"
                       optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ────────────────────────────────────────────────────────── -->
    <record id="view_dg_smart_import_config_form" model="ir.ui.view">
        <field name="name">dg.smart.import.config.form</field>
        <field name="model">dg.smart.import.config</field>
        <field name="arch" type="xml">
            <form string="Smart Import Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="model_id" placeholder="Select a model…"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Model">
                            <field name="model_id"/>
                            <field name="model_name" readonly="1"/>
                        </group>
                        <group string="Settings">
                            <field name="enabled" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <group string="Bound Server Action"
                           invisible="not server_action_id">
                        <field name="server_action_id" readonly="1"/>
                        <div class="alert alert-success" role="alert">
                            <i class="fa fa-check-circle me-1"/>
                            A <strong>Smart Import</strong> action is active on this model.
                            Users in the <em>Smart Import Manager</em> group will see it
                            in the action menu of list and form views.
                        </div>
                    </group>

                    <div class="alert alert-warning"
                         role="alert"
                         invisible="enabled or not model_id">
                        <i class="fa fa-info-circle me-1"/>
                        Smart Import is <strong>disabled</strong> for this model.
                        Enable the toggle above to activate it.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Window Action ────────────────────────────────────────────────────── -->
    <record id="action_dg_smart_import_config" model="ir.actions.act_window">
        <field name="name">Smart Imports</field>
        <field name="res_model">dg.smart.import.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Smart Import configuration yet!
            </p>
            <p>
                Create a configuration entry, choose a model, and enable
                <strong>Smart Import</strong> to allow importing data into it
                via CSV or Excel files.
            </p>
        </field>
    </record>

</odoo>
