<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ═══════════════════════════════════════════════════════════
     SHARED LAYOUT
     ═══════════════════════════════════════════════════════════ -->
<template id="report_wedding_layout">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: 'DejaVu Sans', Arial, sans-serif;">
                    <!-- Header Banner -->
                    <div style="background: linear-gradient(135deg, #6c3082 0%, #a855f7 100%);
                                color: white; padding: 20px 28px; border-radius: 8px;
                                margin-bottom: 24px;">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <div>
                                <h1 style="margin:0; font-size:22px; font-weight:700;">
                                    <t t-esc="doc.name"/>
                                    <span t-if="doc.couple_display" style="font-weight:300; font-size:16px;">
                                        — <t t-esc="doc.couple_display"/>
                                    </span>
                                </h1>
                                <p style="margin:4px 0 0; opacity:0.85; font-size:13px;">
                                    <t t-esc="doc.hall_id.name"/>
                                    <span t-if="doc.wedding_date"> ·
                                        <t t-esc="doc.wedding_date" t-options="{'widget':'datetime','format':'dd MMM yyyy HH:mm'}"/>
                                    </span>
                                </p>
                            </div>
                            <div style="text-align:right; font-size:12px; opacity:0.85;">
                                <strong>Status:</strong>
                                <t t-esc="dict(doc.fields_get(['state'])['state']['selection'])[doc.state]"/>
                            </div>
                        </div>
                    </div>
                    <!-- Content slot -->
                    <t t-raw="0"/>
                </div>
            </t>
        </t>
    </t>
</template>

<!-- ═══════════════════════════════════════════════════════════
     1. FULL EVENT SUMMARY
     ═══════════════════════════════════════════════════════════ -->
<template id="report_wedding_summary">
    <t t-call="dg_wedding_management.report_wedding_layout">
        <!-- Client & Event Info -->
        <div style="display:flex; gap:20px; margin-bottom:20px;">
            <div style="flex:1; background:#f8f4ff; border-left:4px solid #a855f7;
                        padding:14px 16px; border-radius:4px;">
                <h3 style="margin:0 0 10px; color:#6c3082; font-size:13px; text-transform:uppercase; letter-spacing:1px;">
                    Client Information
                </h3>
                <table style="width:100%; font-size:12px; border-collapse:collapse;">
                    <tr><td style="color:#666; padding:2px 0; width:140px;">Client Name</td>
                        <td><strong><t t-esc="doc.wedding_owner_name"/></strong></td></tr>
                    <tr><td style="color:#666;">Mobile</td>
                        <td><t t-esc="doc.wedding_owner_mobile or '—'"/></td></tr>
                    <tr><td style="color:#666;">Email</td>
                        <td><t t-esc="doc.wedding_owner_email or '—'"/></td></tr>
                    <tr><td style="color:#666;">Bride</td>
                        <td><t t-esc="doc.bride_name or '—'"/></td></tr>
                    <tr><td style="color:#666;">Groom</td>
                        <td><t t-esc="doc.groom_name or '—'"/></td></tr>
                    <tr><td style="color:#666;">Contract No.</td>
                        <td><t t-esc="doc.contract_number or '—'"/></td></tr>
                </table>
            </div>
            <div style="flex:1; background:#f8f4ff; border-left:4px solid #a855f7;
                        padding:14px 16px; border-radius:4px;">
                <h3 style="margin:0 0 10px; color:#6c3082; font-size:13px; text-transform:uppercase; letter-spacing:1px;">
                    Event Details
                </h3>
                <table style="width:100%; font-size:12px; border-collapse:collapse;">
                    <tr><td style="color:#666; width:140px;">Hall</td>
                        <td><strong><t t-esc="doc.hall_id.name"/></strong></td></tr>
                    <tr><td style="color:#666;">Start</td>
                        <td><t t-esc="doc.wedding_date" t-options="{'widget':'datetime','format':'dd MMM yyyy HH:mm'}"/></td></tr>
                    <tr><td style="color:#666;">End</td>
                        <td><t t-esc="doc.wedding_date_end" t-options="{'widget':'datetime','format':'dd MMM yyyy HH:mm'}"/></td></tr>
                    <tr><td style="color:#666;">Duration</td>
                        <td><t t-esc="'%.1f hrs' % doc.duration_hours"/></td></tr>
                    <tr><td style="color:#666;">Expected Guests</td>
                        <td><t t-esc="doc.expected_guests"/></td></tr>
                    <tr><td style="color:#666;">Confirmed Guests</td>
                        <td><t t-esc="doc.confirmed_guests"/></td></tr>
                    <tr><td style="color:#666;">Theme</td>
                        <td><t t-esc="doc.theme or '—'"/></td></tr>
                    <tr><td style="color:#666;">Menu Package</td>
                        <td><t t-esc="doc.wedding_menu_id.name if doc.wedding_menu_id else '—'"/></td></tr>
                </table>
            </div>
        </div>

        <!-- Financial Summary -->
        <h3 style="color:#6c3082; font-size:13px; text-transform:uppercase; letter-spacing:1px; margin:0 0 8px;">
            Financial Summary
        </h3>
        <table style="width:100%; border-collapse:collapse; font-size:12px; margin-bottom:20px;">
            <thead>
                <tr style="background:#6c3082; color:white;">
                    <th style="padding:8px 12px; text-align:left;">Item</th>
                    <th style="padding:8px 12px; text-align:right;">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr style="background:#f8f4ff;">
                    <td style="padding:7px 12px;">Total Revenue</td>
                    <td style="padding:7px 12px; text-align:right;">
                        <t t-esc="'%.2f %s' % (doc.wedding_earnings, doc.currency_id.symbol)"/>
                    </td>
                </tr>
                <tr>
                    <td style="padding:7px 12px;">Deposit Received</td>
                    <td style="padding:7px 12px; text-align:right;">
                        <t t-esc="'%.2f %s' % (doc.deposit_amount, doc.currency_id.symbol)"/>
                    </td>
                </tr>
                <tr style="background:#f8f4ff;">
                    <td style="padding:7px 12px;">Balance Due</td>
                    <td style="padding:7px 12px; text-align:right; color:#c0392b; font-weight:600;">
                        <t t-esc="'%.2f %s' % (doc.balance_due, doc.currency_id.symbol)"/>
                    </td>
                </tr>
                <tr>
                    <td style="padding:7px 12px;">Total Cost</td>
                    <td style="padding:7px 12px; text-align:right;">
                        <t t-esc="'%.2f %s' % (doc.total_cost, doc.currency_id.symbol)"/>
                    </td>
                </tr>
                <tr style="background:#6c3082; color:white; font-weight:700;">
                    <td style="padding:8px 12px;">Net Profit</td>
                    <td style="padding:8px 12px; text-align:right;">
                        <t t-esc="'%.2f %s' % (doc.net_profit, doc.currency_id.symbol)"/>
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- Staff Summary -->
        <t t-if="doc.employee_line_ids">
            <h3 style="color:#6c3082; font-size:13px; text-transform:uppercase; letter-spacing:1px; margin:0 0 8px;">
                Staff Summary
            </h3>
            <table style="width:100%; border-collapse:collapse; font-size:12px; margin-bottom:20px;">
                <thead>
                    <tr style="background:#6c3082; color:white;">
                        <th style="padding:7px 12px; text-align:left;">Name</th>
                        <th style="padding:7px 12px; text-align:left;">Role</th>
                        <th style="padding:7px 12px; text-align:center;">Hours</th>
                        <th style="padding:7px 12px; text-align:right;">Pay</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="doc.employee_line_ids" t-as="line">
                        <tr t-att-style="'background:#f8f4ff;' if line_odd else ''">
                            <td style="padding:6px 12px;"><t t-esc="line.employee_id.name"/></td>
                            <td style="padding:6px 12px;"><t t-esc="line.role"/></td>
                            <td style="padding:6px 12px; text-align:center;">
                                <t t-esc="'%.1f' % line.hours_worked if line.payment_type == 'per_wedding' else 'Monthly'"/>
                            </td>
                            <td style="padding:6px 12px; text-align:right;">
                                <t t-esc="'%.2f' % line.total_to_pay"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </t>

        <!-- Notes -->
        <t t-if="doc.wedding_notes">
            <div style="background:#fff8e7; border-left:4px solid #f39c12; padding:12px 16px; border-radius:4px;">
                <strong style="color:#e67e22;">Notes:</strong>
                <p style="margin:6px 0 0; font-size:12px;"><t t-esc="doc.wedding_notes"/></p>
            </div>
        </t>
    </t>
</template>

<!-- ═══════════════════════════════════════════════════════════
     2. STAFF & PAYROLL REPORT
     ═══════════════════════════════════════════════════════════ -->
<template id="report_wedding_staff">
    <t t-call="dg_wedding_management.report_wedding_layout">
        <h3 style="color:#6c3082; font-size:14px; margin-bottom:12px;">Staff &amp; Payroll Report</h3>

        <t t-if="doc.employee_line_ids">
            <table style="width:100%; border-collapse:collapse; font-size:12px;">
                <thead>
                    <tr style="background:#6c3082; color:white;">
                        <th style="padding:8px 12px; text-align:left;">Employee</th>
                        <th style="padding:8px 12px; text-align:left;">Role</th>
                        <th style="padding:8px 12px; text-align:left;">Payment Type</th>
                        <th style="padding:8px 12px; text-align:center;">Hours</th>
                        <th style="padding:8px 12px; text-align:right;">Event Fee</th>
                        <th style="padding:8px 12px; text-align:right;">Total Pay</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="doc.employee_line_ids" t-as="line">
                        <tr t-att-style="'background:#f8f4ff;' if line_odd else ''">
                            <td style="padding:7px 12px; font-weight:600;">
                                <t t-esc="line.employee_id.name"/>
                            </td>
                            <td style="padding:7px 12px;"><t t-esc="line.role"/></td>
                            <td style="padding:7px 12px;"><t t-esc="line.payment_type"/></td>
                            <td style="padding:7px 12px; text-align:center;">
                                <t t-esc="'%.1f' % line.hours_worked if line.payment_type == 'per_wedding' else '—'"/>
                            </td>
                            <td style="padding:7px 12px; text-align:right;">
                                <t t-esc="'%.2f' % line.event_fee if line.payment_type == 'per_wedding' else '—'"/>
                            </td>
                            <td style="padding:7px 12px; text-align:right; font-weight:600;">
                                <t t-esc="'%.2f %s' % (line.total_to_pay, doc.currency_id.symbol)"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
                <tfoot>
                    <tr style="background:#6c3082; color:white; font-weight:700;">
                        <td colspan="5" style="padding:8px 12px; text-align:right;">TOTAL</td>
                        <td style="padding:8px 12px; text-align:right;">
                            <t t-esc="'%.2f %s' % (sum(doc.employee_line_ids.mapped('total_to_pay')), doc.currency_id.symbol)"/>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </t>
        <t t-else="">
            <p style="color:#999; font-style:italic;">No staff assigned to this event.</p>
        </t>
    </t>
</template>

<!-- ═══════════════════════════════════════════════════════════
     3. FINANCIAL REPORT
     ═══════════════════════════════════════════════════════════ -->
<template id="report_wedding_financial">
    <t t-call="dg_wedding_management.report_wedding_layout">
        <h3 style="color:#6c3082; font-size:14px; margin-bottom:12px;">Financial Report</h3>

        <!-- Revenue section -->
        <div style="background:#f0fdf4; border-left:4px solid #22c55e; padding:12px 16px; margin-bottom:14px; border-radius:4px;">
            <strong style="color:#16a34a;">Revenue</strong>
            <table style="width:100%; font-size:12px; margin-top:8px;">
                <tr><td style="color:#666;">Total Revenue</td>
                    <td style="text-align:right; font-weight:600;">
                        <t t-esc="'%.2f %s' % (doc.wedding_earnings, doc.currency_id.symbol)"/>
                    </td></tr>
                <tr><td style="color:#666;">Deposit Received</td>
                    <td style="text-align:right;">
                        <t t-esc="'%.2f %s' % (doc.deposit_amount, doc.currency_id.symbol)"/>
                    </td></tr>
                <tr><td style="color:#666;">Balance Due</td>
                    <td style="text-align:right; color:#c0392b; font-weight:600;">
                        <t t-esc="'%.2f %s' % (doc.balance_due, doc.currency_id.symbol)"/>
                    </td></tr>
            </table>
        </div>

        <!-- Costs section -->
        <div style="background:#fef2f2; border-left:4px solid #ef4444; padding:12px 16px; margin-bottom:14px; border-radius:4px;">
            <strong style="color:#dc2626;">Costs</strong>
            <table style="width:100%; font-size:12px; margin-top:8px;">
                <tr><td style="color:#666;">Hall Hire Fee</td>
                    <td style="text-align:right;">
                        <t t-esc="'%.2f %s' % (doc.hall_hire_fee, doc.currency_id.symbol)"/>
                    </td></tr>
                <tr><td style="color:#666;">Staff Costs</td>
                    <td style="text-align:right;">
                        <t t-esc="'%.2f %s' % (sum(doc.employee_line_ids.mapped('total_to_pay')), doc.currency_id.symbol)"/>
                    </td></tr>
                <tr><td style="color:#666;">Additional Expenses</td>
                    <td style="text-align:right;">
                        <t t-esc="'%.2f %s' % (sum(doc.spending_line_ids.mapped('amount')), doc.currency_id.symbol)"/>
                    </td></tr>
                <tr style="font-weight:700;"><td>Total Cost</td>
                    <td style="text-align:right;">
                        <t t-esc="'%.2f %s' % (doc.total_cost, doc.currency_id.symbol)"/>
                    </td></tr>
            </table>
        </div>

        <!-- Additional expenses -->
        <t t-if="doc.spending_line_ids">
            <h4 style="color:#6c3082; font-size:12px; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">
                Expense Breakdown
            </h4>
            <table style="width:100%; border-collapse:collapse; font-size:11px;">
                <thead>
                    <tr style="background:#6c3082; color:white;">
                        <th style="padding:6px 10px; text-align:left;">Date</th>
                        <th style="padding:6px 10px; text-align:left;">Category</th>
                        <th style="padding:6px 10px; text-align:left;">Description</th>
                        <th style="padding:6px 10px; text-align:right;">Amount</th>
                        <th style="padding:6px 10px; text-align:center;">Paid</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="doc.spending_line_ids" t-as="exp">
                        <tr t-att-style="'background:#f8f4ff;' if exp_odd else ''">
                            <td style="padding:5px 10px;">
                                <t t-esc="exp.date" t-options="{'widget':'date','format':'dd/MM/yyyy'}"/>
                            </td>
                            <td style="padding:5px 10px;"><t t-esc="exp.category"/></td>
                            <td style="padding:5px 10px;"><t t-esc="exp.name"/></td>
                            <td style="padding:5px 10px; text-align:right;">
                                <t t-esc="'%.2f' % exp.amount"/>
                            </td>
                            <td style="padding:5px 10px; text-align:center;">
                                <t t-esc="'✓' if exp.paid else '✗'"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </t>

        <!-- Net profit box -->
        <div t-att-style="'margin-top:16px; padding:14px 20px; border-radius:8px; text-align:center; font-size:16px; font-weight:700; ' + ('background:#f0fdf4; color:#16a34a;' if doc.net_profit >= 0 else 'background:#fef2f2; color:#dc2626;')">
            Net Profit: <t t-esc="'%.2f %s' % (doc.net_profit, doc.currency_id.symbol)"/>
        </div>
    </t>
</template>

<!-- ═══════════════════════════════════════════════════════════
     4. TABLE PLAN REPORT
     ═══════════════════════════════════════════════════════════ -->
<template id="report_wedding_table_plan">
    <t t-call="dg_wedding_management.report_wedding_layout">
        <h3 style="color:#6c3082; font-size:14px; margin-bottom:4px;">Table Plan</h3>
        <p style="font-size:11px; color:#666; margin-bottom:14px;">
            Hall: <strong><t t-esc="doc.hall_id.name"/></strong> ·
            Tables assigned: <strong><t t-esc="doc.tables_assigned"/></strong> ·
            Total seated: <strong><t t-esc="doc.total_seated"/></strong>
        </p>

        <t t-if="doc.table_line_ids">
            <table style="width:100%; border-collapse:collapse; font-size:12px;">
                <thead>
                    <tr style="background:#6c3082; color:white;">
                        <th style="padding:8px 10px; text-align:left;">Table</th>
                        <th style="padding:8px 10px; text-align:left;">Shape</th>
                        <th style="padding:8px 10px; text-align:center;">Capacity</th>
                        <th style="padding:8px 10px; text-align:center;">Seated</th>
                        <th style="padding:8px 10px; text-align:center;">Occupancy</th>
                        <th style="padding:8px 10px; text-align:left;">Waiter</th>
                        <th style="padding:8px 10px; text-align:center;">VIP</th>
                        <th style="padding:8px 10px; text-align:left;">Notes</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="doc.table_line_ids" t-as="tbl">
                        <tr t-att-style="'background:#fff8f0; font-weight:600;' if tbl.is_vip else ('background:#f8f4ff;' if tbl_odd else '')">
                            <td style="padding:6px 10px;"><t t-esc="tbl.table_id.name"/></td>
                            <td style="padding:6px 10px;"><t t-esc="tbl.table_shape"/></td>
                            <td style="padding:6px 10px; text-align:center;"><t t-esc="tbl.standard_capacity"/></td>
                            <td style="padding:6px 10px; text-align:center;"><t t-esc="tbl.actual_guests"/></td>
                            <td style="padding:6px 10px; text-align:center;">
                                <t t-esc="'%.0f%%' % tbl.occupancy_pct"/>
                            </td>
                            <td style="padding:6px 10px;">
                                <t t-esc="tbl.assigned_waiter_id.name if tbl.assigned_waiter_id else '—'"/>
                            </td>
                            <td style="padding:6px 10px; text-align:center;">
                                <t t-esc="'★' if tbl.is_vip else ''"/>
                            </td>
                            <td style="padding:6px 10px; font-size:11px; color:#666;">
                                <t t-esc="tbl.special_notes or ''"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </t>
        <t t-else="">
            <p style="color:#999; font-style:italic;">No tables assigned to this wedding event yet.</p>
        </t>
    </t>
</template>

</odoo>
