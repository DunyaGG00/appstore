<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dg_wedding_table_list" model="ir.ui.view">
        <field name="name">dg.wedding.table.list</field>
        <field name="model">dg.wedding.table</field>
        <field name="arch" type="xml">
            <list string="Tables">
                <field name="hall_id"/>
                <field name="name"/>
                <field name="shape"/>
                <field name="guest_capacity"/>
                <field name="notes" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_dg_wedding_table_form" model="ir.ui.view">
        <field name="name">dg.wedding.table.form</field>
        <field name="model">dg.wedding.table</field>
        <field name="arch" type="xml">
            <form string="Physical Table">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Table No. / Name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="hall_id"/>
                            <field name="shape"/>
                            <field name="guest_capacity"/>
                        </group>
                        <group string="Floor Plan Position">
                            <field name="position_x"/>
                            <field name="position_y"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dg_wedding_table" model="ir.actions.act_window">
        <field name="name">Tables</field>
        <field name="res_model">dg.wedding.table</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add physical tables to your halls</p>
        </field>
    </record>

</odoo>
