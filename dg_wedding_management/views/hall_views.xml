<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dg_wedding_hall_list" model="ir.ui.view">
        <field name="name">dg.wedding.hall.list</field>
        <field name="model">dg.wedding.hall</field>
        <field name="arch" type="xml">
            <list string="Halls">
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <field name="table_count"/>
                <field name="total_guest_capacity"/>
                <field name="base_hire_fee" widget="monetary" options="{'currency_field':'currency_id'}"/>
                <field name="wedding_count"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dg_wedding_hall_form" model="ir.ui.view">
        <field name="name">dg.wedding.hall.form</field>
        <field name="model">dg.wedding.hall</field>
        <field name="arch" type="xml">
            <form string="Wedding Hall">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_weddings" icon="fa-calendar">
                            <field name="wedding_count" widget="statinfo" string="Weddings"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_open_hall_plan" icon="fa-th-large">
                            <span class="o_stat_text">Floor Plan</span>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Hall Name..."/></h1>
                        <h2><field name="code" placeholder="Hall Code..."/></h2>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="address"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Capacity">
                            <field name="table_count" readonly="1"/>
                            <field name="total_guest_capacity" readonly="1"/>
                            <field name="base_hire_fee" widget="monetary" options="{'currency_field':'currency_id'}"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description, notes, facilities..."/>
                    <notebook>
                        <page string="Tables" name="tables">
                            <field name="physical_table_ids">
                                <list editable="bottom" string="Physical Tables">
                                    <field name="name" placeholder="Table number / name..."/>
                                    <field name="shape"/>
                                    <field name="guest_capacity"/>
                                    <field name="position_x" optional="show"/>
                                    <field name="position_y" optional="show"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dg_wedding_hall" model="ir.actions.act_window">
        <field name="name">Halls &amp; Venues</field>
        <field name="res_model">dg.wedding.hall</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first Wedding Hall</p>
        </field>
    </record>

</odoo>
