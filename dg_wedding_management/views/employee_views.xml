<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dg_wedding_employee_list" model="ir.ui.view">
        <field name="name">dg.wedding.employee.list</field>
        <field name="model">dg.wedding.employee</field>
        <field name="arch" type="xml">
            <list string="Employees">
                <field name="name"/>
                <field name="employee_type"/>
                <field name="phone"/>
                <field name="payment_type"/>
                <field name="monthly_wage" optional="show"/>
                <field name="default_hourly_rate" optional="show"/>
                <field name="assignment_count"/>
                <field name="total_earned" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_dg_wedding_employee_kanban" model="ir.ui.view">
        <field name="name">dg.wedding.employee.kanban</field>
        <field name="model">dg.wedding.employee</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="employee_type"/>
                <field name="phone"/>
                <field name="image"/>
                <field name="assignment_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center gap-2">
                            <field name="image" widget="image" class="o_kanban_image rounded-circle" style="width:48px;height:48px;object-fit:cover"/>
                            <div>
                                <strong t-esc="record.name.value"/>
                                <div class="text-muted small" t-esc="record.employee_type.value"/>
                            </div>
                        </div>
                        <div class="mt-2">
                            <i class="fa fa-phone me-1 text-muted"/>
                            <span t-esc="record.phone.value or '—'"/>
                        </div>
                        <footer>
                            <span class="badge bg-secondary">
                                <t t-esc="record.assignment_count.value"/> events
                            </span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dg_wedding_employee_form" model="ir.ui.view">
        <field name="name">dg.wedding.employee.form</field>
        <field name="model">dg.wedding.employee</field>
        <field name="arch" type="xml">
            <form string="Wedding Employee">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_assignments" icon="fa-calendar-check-o">
                            <field name="assignment_count" widget="statinfo" string="Events"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Full Name..."/></h1>
                    </div>
                    <group>
                        <group string="Role &amp; Contact">
                            <field name="employee_type"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="id_number"/>
                        </group>
                        <group string="Payment">
                            <field name="payment_type"/>
                            <field name="monthly_wage" invisible="payment_type != 'monthly'"/>
                            <field name="default_hourly_rate" invisible="payment_type != 'per_wedding'"/>
                            <field name="total_earned" readonly="1"/>
                        </group>
                    </group>
                    <field name="address" placeholder="Address..."/>
                    <field name="notes" placeholder="Internal notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dg_wedding_employee" model="ir.actions.act_window">
        <field name="name">Staff</field>
        <field name="res_model">dg.wedding.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first staff member</p>
        </field>
    </record>

</odoo>
